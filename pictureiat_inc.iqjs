/ onTrialBegin = {
	values.progressWidth+= 10;
	values.instructionIndex++;
}
/ stimulusTimes = [1=instructions, spacebar, progressbar, progressbarFill]
/ correctResponse = (" ")
/ errorMessage = false
/ recordData = false
/ showMouseCursor = true
</trial>

