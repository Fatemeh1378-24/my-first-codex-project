{
  "name": "iat-results-relay",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-26",
  "workers_dev": true,
  "vars": {"ALLOWED_ORIGIN": "https://fatemeh1378-24.github.io"},
  "ratelimits": [{
    "name": "RESULTS_RATE_LIMITER",
    "namespace_id": "1001",
    "simple": {"limit": 30, "period": 60}
  }],
  "observability": {"enabled": false}
}
