//////////////////////////////////////////////////////////////////////////////////////////////////////////////
HELPER SCRIPT: contains the generic instructions for Inquisit IATs using Persian text & picture stimuli
//////////////////////////////////////////////////////////////////////////////////////////////////////////////

**************************************************************************************************************
**************************************************************************************************************
	EDITABLE INSTRUCTIONS: change instructions here
**************************************************************************************************************
**************************************************************************************************************
<instruct>
/ navigationButtonFontStyle = ("Arial", 3%, false, false, false, false, 5, 1)
</instruct>

<item instructions>
/ 1 = "انگشت دست چپ خود را برای مواردی که به دستهٔ «<%expressions.leftTarget%>» تعلق دارند، روی کلید پاسخ «E» بگذارید.
انگشت دست راست خود را برای مواردی که به دستهٔ «<%expressions.rightTarget%>» تعلق دارند، روی کلید پاسخ «I» بگذارید.
\nموارد یکی‌یکی در وسط صفحه ظاهر می‌شوند.
\nاگر اشتباه کنید، یک علامت X قرمز ظاهر می‌شود؛ برای ادامه، کلید پاسخ دیگر را فشار دهید.
\nتا جای ممکن سریع پاسخ دهید و تا حد امکان اشتباه کمتری داشته باشید."

/ 2 = "انگشت دست چپ خود را برای مواردی که به دستهٔ «<%item.attributeALabel.item(0)%>» تعلق دارند، روی کلید پاسخ «E» بگذارید.
انگشت دست راست خود را برای مواردی که به دستهٔ «<%item.attributeBLabel.item(0)%>» تعلق دارند، روی کلید پاسخ «I» بگذارید.
\nاگر اشتباه کنید، یک علامت X قرمز ظاهر می‌شود؛ برای ادامه، کلید پاسخ دیگر را فشار دهید.
\nتا جای ممکن سریع پاسخ دهید و تا حد امکان اشتباه کمتری داشته باشید."

/ 3 = "برای «<%item.attributeALabel.item(0)%>» و «<%expressions.leftTarget%>»، کلید سمت چپ «E» را فشار دهید.
برای «<%item.attributeBLabel.item(0)%>» و «<%expressions.rightTarget%>»، کلید سمت راست «I» را فشار دهید.
\nهر مورد فقط به یکی از دسته‌ها تعلق دارد.
\nاگر اشتباه کنید، یک علامت X قرمز ظاهر می‌شود؛ برای ادامه، کلید پاسخ دیگر را فشار دهید.
\nتا جای ممکن سریع پاسخ دهید و تا حد امکان اشتباه کمتری داشته باشید."

/ 4 = "این تکلیف همان تکلیف بخش قبلی است.
\n\nبرای «<%item.attributeALabel.item(0)%>» و «<%expressions.leftTarget%>»، کلید سمت چپ «E» را فشار دهید.
برای «<%item.attributeBLabel.item(0)%>» و «<%expressions.rightTarget%>»، کلید سمت راست «I» را فشار دهید.
\nهر مورد فقط به یکی از دسته‌ها تعلق دارد.
\nتا جای ممکن سریع پاسخ دهید و تا حد امکان اشتباه کمتری داشته باشید."

/ 5 = "توجه! جای برچسب‌ها عوض شده است.
\nبرای «<%expressions.rightTarget%>»، کلید سمت چپ «E» را فشار دهید.
برای «<%expressions.leftTarget%>»، کلید سمت راست «I» را فشار دهید.
\nتا جای ممکن سریع پاسخ دهید و تا حد امکان اشتباه کمتری داشته باشید."

/ 6 = "برای «<%item.attributeALabel.item(0)%>» و «<%expressions.rightTarget%>»، کلید سمت چپ «E» را فشار دهید.
برای «<%item.attributeBLabel.item(0)%>» و «<%expressions.leftTarget%>»، کلید سمت راست «I» را فشار دهید.
\nاگر اشتباه کنید، یک علامت X قرمز ظاهر می‌شود؛ برای ادامه، کلید پاسخ دیگر را فشار دهید.
\nتا جای ممکن سریع پاسخ دهید و تا حد امکان اشتباه کمتری داشته باشید."

/ 7 = "این تکلیف همان تکلیف بخش قبلی است.
\nبرای «<%item.attributeALabel.item(0)%>» و «<%expressions.rightTarget%>»، کلید سمت چپ «E» را فشار دهید.
برای «<%item.attributeBLabel.item(0)%>» و «<%expressions.leftTarget%>»، کلید سمت راست «I» را فشار دهید.
\nهر مورد فقط به یکی از دسته‌ها تعلق دارد.
\nتا جای ممکن سریع پاسخ دهید و تا حد امکان اشتباه کمتری داشته باشید."
</item>

Note: expressions used to assign the correct label to the left and right response keys
<expressions>
/ leftTarget = if(values.conditionOrder == "c-ic"){
	return item.targetALabel.item(0);
} else {
	return item.targetBLabel.item(0);
}
/ rightTarget = if (values.conditionOrder == "c-ic"){
	return item.targetBLabel.item(0);
} else {
	return item.targetALabel.item(0);
}
</expressions>

<text orLeft>
/ items = ("یا")
/ vAlign = top
/ hAlign = left
/ position = (5%, 12%)
/ fontStyle = ("Arial", 5%)
</text>

<text orRight>
/ items = ("یا")
/ vAlign = top
/ hAlign = right
/ position = (95%, 12%)
/ fontStyle = ("Arial", 5%)
</text>

<text spacebar>
/ items = ("برای شروع، کلید فاصله را فشار دهید.")
/ position = (50%, 90%)
/ vAlign = bottom
</text>

<text errorReminder>
/ items = ("اگر اشتباه کنید، یک علامت X قرمز ظاهر می‌شود. برای ادامه، کلید دیگر را فشار دهید.")
/ position = (50%, 95%)
/ vAlign = bottom
/ fontStyle = ("Arial", 3%, false, false, false, false, 5, 1)
/ txColor = gray
/ erase = false
</text>

***********************************************************************
Performance summary
***********************************************************************

<trial summary>
/ onTrialBegin = {
	values.magnitude = "تقریباً هیچ یا میزان ناچیزی از";
	if( abs(expressions.d) > 0.15 ) values.magnitude = "اندکی";
	if( abs(expressions.d) > 0.35 ) values.magnitude = "میزان متوسطی از";
	if( abs(expressions.d) >= 0.65 ) values.magnitude = "میزان زیادی از";
	if (expressions.d >= 0.0)
		values.preferred = item.targetALabel.item(0);
	if (expressions.d < 0.0)
		values.preferred = item.targetBLabel.item(0);
	if (expressions.d < 0.0)
		values.notPreferred= item.targetALabel.item(0);
	if (expressions.d >= 0.0)
		values.notPreferred= item.targetBLabel.item(0);
}
/ stimulusTimes = [0=summary]
/ validResponse = (" ")
/ recordData = false
</trial>


<text summary>
/ items = ("نمرهٔ آزمون تداعی ضمنی (D) شما <% expressions.d %> بود. این نمره نشان‌دهندهٔ <% values.magnitude %> ترجیح خودکار برای برقراری تداعی‌های زیر است:


* «<% values.preferred %>» با «<%item.attributeALabel.item(0)%>»، به‌جای «<%item.attributeBLabel.item(0)%>»
 
* «<% values.notPreferred %>» با «<%item.attributeBLabel.item(0)%>»، به‌جای «<%item.attributeALabel.item(0)%>».
\n\n\nبرای پایان دادن به این جلسه، کلید فاصله را فشار دهید.")
/ size = (60%, 60%)
/ hJustify = right
 </text>

**************************************************************************************************************
												End of File
**************************************************************************************************************
